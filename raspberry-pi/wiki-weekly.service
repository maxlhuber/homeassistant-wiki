[Unit]
Description=Wöchentliche Home-Assistant-Wiki-Aufbereitung
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/homeassistant-backups
OnFailure=wiki-weekly-onfailure.service

[Service]
Type=oneshot
User=wikiadmin
Group=wikiadmin
WorkingDirectory=/srv/homeassistant-wiki/source
EnvironmentFile=-/etc/homeassistant-wiki/weekly.env
LoadCredential=ha_backup_key:/etc/homeassistant-wiki/ha-backup-key
LoadCredential=openai_api_key:/etc/homeassistant-wiki/openai-api-key
LoadCredential=github_key:/home/wikiadmin/.ssh/github_homeassistant_wiki
LoadCredential=github_known_hosts:/etc/homeassistant-wiki/github-known-hosts
LoadCredential=ha_webhook_url:/etc/homeassistant-wiki/ha-webhook-url
ExecStart=/usr/local/sbin/wiki-weekly-update
ExecStartPost=+/usr/local/sbin/wiki-weekly-publish
TimeoutStartSec=30min
StateDirectory=homeassistant-wiki
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/mnt/homeassistant-backups
ReadOnlyPaths=/etc/homeassistant-wiki/github-known-hosts
ReadOnlyPaths=/opt/homeassistant-wiki-runner /usr/local/sbin/wiki-weekly-update /usr/local/sbin/wiki-weekly-publish /usr/local/sbin/wiki-publish-static
ReadWritePaths=/srv/homeassistant-wiki/source /var/lib/homeassistant-wiki /var/www /var/log/nginx

[Install]
WantedBy=multi-user.target
