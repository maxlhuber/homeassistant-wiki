# Diese Datei ist nur eine Vorlage. Echte Werte gehören ausschließlich nach
# /etc/homeassistant-wiki/weekly.env auf dem Raspberry Pi (ohne Geheimnisse, Modus 0644).
WIKI_REPO_DIR=/srv/homeassistant-wiki/source
WIKI_STATE_DIR=/var/lib/homeassistant-wiki
WIKI_BACKUP_DIR=/mnt/homeassistant-backups
WIKI_RUNNER_DIR=/opt/homeassistant-wiki-runner
WIKI_MAX_BACKUP_AGE=691200
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

# Geheimnisse werden als systemd-Credentials geladen und gehören nie hier hinein.
